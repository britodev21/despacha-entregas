# Copie para .env e preencha. NUNCA versione o .env.
# Gere senhas fortes, por exemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"

# development | test | production
APP_ENV=development
LOG_LEVEL=INFO

# Usuário da APLICAÇÃO (somente SELECT/INSERT/UPDATE/DELETE)
DATABASE_URL=postgresql+psycopg://despacha_app:<SENHA_APP>@localhost:5432/despacha

# Usuário DONO do schema (somente para rodar migrations)
MIGRATIONS_DATABASE_URL=postgresql+psycopg://despacha_owner:<SENHA_OWNER>@localhost:5432/despacha

# Banco usado pelos testes automatizados (é apagado a cada execução!)
TEST_DATABASE_URL=postgresql+psycopg://despacha_app:<SENHA_APP>@localhost:5432/despacha_test
TEST_MIGRATIONS_DATABASE_URL=postgresql+psycopg://despacha_owner:<SENHA_OWNER>@localhost:5432/despacha_test

# Origens permitidas, separadas por vírgula.
# Deixe vazio quando frontend e API estiverem na mesma origem (padrão: Vite proxy / Nginx).
CORS_ORIGINS=

# Segredo que assina os JWT (mínimo 32 caracteres). Gere um aleatório:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Trocar este valor invalida todas as sessões ativas.
JWT_SECRET=<GERE_UM_SEGREDO_ALEATORIO>

# Só desenvolvimento: senha dos usuários criados por `uv run python -m app.cli seed-dev`.
DEV_SEED_PASSWORD=<SENHA_DOS_USUARIOS_DEMO>

# Dias de retenção das posições dos entregadores (LGPD). Padrão: 30.
LOCATION_RETENTION_DAYS=30
