# DESPACHA — configuração de PRODUÇÃO do docker-compose.yml (no servidor).
# Copie para `.env` (na mesma pasta do docker-compose.yml) e preencha.
# NUNCA versione o .env. Para desenvolvimento local, use backend/.env.example.
#
# Senhas e segredos: só letras e números, gerados no servidor, por exemplo:
#   openssl rand -hex 24

# Subdomínio que aponta para o servidor (registro A).
DOMINIO=<SEU_DOMINIO>

# Banco (criados na primeira subida; para trocar depois, veja deploy/README.md).
POSTGRES_PASSWORD=<GERE_UMA_SENHA>
DESPACHA_OWNER_PASSWORD=<GERE_UMA_SENHA>
DESPACHA_APP_PASSWORD=<GERE_UMA_SENHA>

# Assina os JWT (mínimo 32 caracteres; openssl rand -hex 32).
# Trocar este valor encerra todas as sessões.
JWT_SECRET=<GERE_UM_SEGREDO>

# Nomes usados pelo Traefik do servidor (os padrões são os mais comuns).
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Processos da API (2 basta para um pequeno negócio).
WEB_CONCURRENCY=2

# Dias de retenção das posições dos entregadores (LGPD).
LOCATION_RETENTION_DAYS=30

# Mapa. Vazio = OpenStreetMap, adequado para pouco volume. Com mais uso,
# contrate um provedor de tiles e preencha os três (a origem vai para a CSP).
MAP_TILE_URL=
MAP_ATTRIBUTION=
MAP_TILE_ORIGIN=https://tile.openstreetmap.org
