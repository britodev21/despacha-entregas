# Variáveis VITE_* vão para o JavaScript entregue ao navegador: são PÚBLICAS.
# Nunca coloque segredos aqui.

# Tiles do mapa (Leaflet). Em produção, use um provedor de tiles com plano
# adequado: a política dos servidores oficiais do OpenStreetMap não permite
# uso comercial intenso. Lembre de liberar o domínio na CSP (img-src).
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap
