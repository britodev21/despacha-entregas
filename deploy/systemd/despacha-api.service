# DESPACHA — API (FastAPI/Uvicorn). Instale em /etc/systemd/system/.
#   systemctl daemon-reload && systemctl enable --now despacha-api

[Unit]
Description=DESPACHA API (FastAPI)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=despacha
Group=despacha
WorkingDirectory=/opt/despacha/app/backend
# Segredos fora do repositório, legíveis só por root (chmod 600): o systemd lê
# o arquivo antes de trocar de usuário. A credencial de migrations NÃO fica aqui.
EnvironmentFile=/etc/despacha/backend.env

# - 127.0.0.1: a API nunca fica exposta à internet; só o Nginx fala com ela.
# - --proxy-headers + --forwarded-allow-ips: confia no X-Forwarded-For SÓ do
#   Nginx local (IP real para rate limit e auditoria; ninguém forja de fora).
# - --no-server-header: não anuncia "uvicorn".
# - 2 workers: suficiente para um pequeno negócio; ajuste pela CPU do VPS.
ExecStart=/opt/despacha/app/backend/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 --port 8000 --workers 2 \
    --proxy-headers --forwarded-allow-ips 127.0.0.1 \
    --no-server-header --no-access-log

Restart=on-failure
RestartSec=5

# ------------------------------------------------ isolamento (hardening)
# Se a aplicação for invadida, o estrago fica contido.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
# Única pasta gravável: os uploads.
ReadWritePaths=/var/lib/despacha/uploads
UMask=0027

[Install]
WantedBy=multi-user.target
