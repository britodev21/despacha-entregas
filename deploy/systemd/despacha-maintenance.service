# Limpezas diárias (LGPD e higiene): posições antigas e sessões vencidas.
[Unit]
Description=DESPACHA manutenção diária (purge-locations, purge-sessions)
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
ExecStart=/docker/despacha/deploy/scripts/cli.sh purge-locations
ExecStart=/docker/despacha/deploy/scripts/cli.sh purge-sessions
