# Backup sem teste de restauração não é backup. Este serviço restaura o
# backup mais recente num PostgreSQL TEMPORÁRIO e sem rede, confere e apaga.
[Unit]
Description=DESPACHA teste de restauração do backup
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
ExecStart=/docker/despacha/deploy/scripts/restore-test.sh
Nice=10
PrivateTmp=true
