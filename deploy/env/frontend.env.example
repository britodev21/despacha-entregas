# DESPACHA — variáveis do BUILD do frontend em produção.
# Instale em /etc/despacha/frontend.env  (dono root, chmod 644).
#
# Tudo que começa com VITE_ vai para o JavaScript entregue ao navegador:
# é PÚBLICO. Nunca coloque segredos aqui.

# Provedor de tiles do mapa com plano comercial adequado.
# Lembre de liberar o mesmo domínio na CSP do Nginx (img-src).
VITE_MAP_TILE_URL=https://<PROVEDOR_DE_TILES>/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=<ATRIBUICAO_EXIGIDA_PELO_PROVEDOR>
