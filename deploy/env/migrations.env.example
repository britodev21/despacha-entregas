# DESPACHA — credencial do DONO do schema, usada SÓ para rodar migrations.
# Instale em /etc/despacha/migrations.env  (dono root, chmod 600).
#
# Fica separada do backend.env de propósito: a API em execução nunca recebe
# esta credencial. Se a API for invadida, o atacante não consegue alterar ou
# apagar tabelas, nem mexer no histórico de auditoria.

MIGRATIONS_DATABASE_URL=postgresql+psycopg://despacha_owner:<SENHA_OWNER>@127.0.0.1:5432/despacha
