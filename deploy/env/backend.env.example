# DESPACHA — variáveis da API em PRODUÇÃO.
# Instale em /etc/despacha/backend.env  (dono root, chmod 600).
# Este arquivo é só um MODELO: nunca versione valores reais.
#
# Gere segredos com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

APP_ENV=production
LOG_LEVEL=INFO

# Usuário da APLICAÇÃO: só SELECT/INSERT/UPDATE/DELETE. Banco no próprio
# servidor, sem porta exposta à internet.
DATABASE_URL=postgresql+psycopg://despacha_app:<SENHA_APP>@127.0.0.1:5432/despacha

# Mesma origem (Nginx serve frontend e API): deixe vazio.
# Se um dia separar os domínios, use só https://.
CORS_ORIGINS=

# Assina os JWT. Mínimo 32 caracteres, aleatório, exclusivo da produção.
# Trocar este valor encerra todas as sessões.
JWT_SECRET=<GERE_UM_SEGREDO_ALEATORIO>

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Posições dos entregadores (LGPD): dias de retenção.
LOCATION_RETENTION_DAYS=30

# Fotos e assinaturas: fora da pasta pública e incluída no backup.
UPLOAD_DIR=/var/lib/despacha/uploads
MAX_UPLOAD_MB=8

# NÃO defina DEV_SEED_PASSWORD em produção (a API se recusa a subir).
