# DESPACHA — configuração do backup e do teste de restauração (no servidor).
# Instale em /etc/despacha/backup.env  (dono root, chmod 600).

# Pasta do docker-compose.yml do DESPACHA.
APP_DIR=/docker/despacha

BACKUP_DIR=/root/backups/despacha
RETENTION_DAYS=14

# Chaves PÚBLICAS do age (uma por linha): a do dono e a do servidor.
# Ver deploy/README.md, "Backup cifrado".
AGE_RECIPIENTS_FILE=/etc/despacha/backup-recipients.txt

# Cópia fora do servidor (remote configurado com `rclone config`).
# Vazio = só backup local, que NÃO protege contra perda do servidor.
RCLONE_REMOTE=

# Opcional: URLs de "ping" de um serviço de monitoramento de tarefas agendadas.
# Se o ping não chegar no horário, o serviço avisa você.
HEALTHCHECK_URL=
RESTORE_TEST_HEALTHCHECK_URL=
